{% if site.ga4_id %}
	<!-- Google Analytics 4 -->
	<script>
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}

	// Local previews must not land in the property. Without this, every
	// `npm run dev` session shows up as real traffic from a real reader.
	if (/^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)) {
		console.info('[analytics] local preview: GA4 disabled ({{ site.ga4_id }})');
	} else {
		var s = document.createElement('script');
		s.async = true;
		s.src = 'https://www.googletagmanager.com/gtag/js?id={{ site.ga4_id }}';
		document.head.appendChild(s);
		gtag('js', new Date());
		gtag('config', '{{ site.ga4_id }}');
	}

	// GA4 enhanced measurement already reports page_view, outbound clicks, file
	// downloads and a single 90% scroll event. These add the read-depth detail
	// that tells you whether long posts are actually being read.
	document.addEventListener('DOMContentLoaded', function () {
		var article = document.querySelector('.post-body');
		if (!article) return;
		var fired = {};
		var marks = [25, 50, 75, 100];
		var start = Date.now();

		function check() {
			var box = article.getBoundingClientRect();
			var seen = window.innerHeight - box.top;
			var pct = Math.min(100, Math.max(0, (seen / box.height) * 100));
			marks.forEach(function (m) {
				if (pct >= m && !fired[m]) {
					fired[m] = true;
					gtag('event', 'read_depth', {
						percent: m,
						post: document.title,
						seconds: Math.round((Date.now() - start) / 1000)
					});
				}
			});
		}
		var ticking = false;
		window.addEventListener('scroll', function () {
			if (ticking) return;
			ticking = true;
			window.requestAnimationFrame(function () { check(); ticking = false; });
		}, { passive: true });
		check();
	});
	</script>
{% endif %}
