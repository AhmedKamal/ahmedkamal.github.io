{% if site.disqus_shortname %}
<section class="comments" id="comments">
	<button type="button" class="comments-open" id="comments-open">Show comments</button>
	<div id="disqus_thread"></div>
</section>
<script>
// Disqus is ~1MB of third-party JavaScript. Loading it only on click keeps the
// page fast and keeps its trackers off readers who never open the thread.
(function () {
	var btn = document.getElementById('comments-open');
	if (!btn) return;
	btn.addEventListener('click', function () {
		btn.disabled = true;
		btn.textContent = 'Loading comments…';
		window.disqus_config = function () {
			this.page.url = '{{ site.origin }}{{ page.url | url }}';
			this.page.identifier = '{{ slug }}';
			this.page.title = {{ title | dump | safe }};
		};
		var s = document.createElement('script');
		s.src = 'https://{{ site.disqus_shortname }}.disqus.com/embed.js';
		s.setAttribute('data-timestamp', String(+new Date()));
		s.onload = function () { btn.remove(); };
		(document.head || document.body).appendChild(s);
		if (window.gtag) gtag('event', 'comments_open', { post: {{ title | dump | safe }} });
	});
})();
</script>
{% endif %}
